<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="mail_primary">#FF1A73E8</color>
    <color name="mail_secondary_text">#FF5F6368</color>

    <style name="Base.FixtureTheme" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/mail_primary</item>
        <item name="android:colorPrimaryDark">@color/mail_primary</item>
        <item name="android:colorAccent">@color/mail_primary</item>
    </style>

    <style name="FixtureTheme" parent="Base.FixtureTheme" />

    <!-- Plain-text action buttons: no ALL CAPS, so the accessibility text is exactly "Reply" / "Archive". -->
    <style name="FixtureButton" parent="@android:style/Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
    </style>
</resources>
