---
// The approval prompt the app shows before a sensitive action, recreated in HTML.
---

<div class="relative mx-auto w-full max-w-[340px]">
  <!-- Agent request bubble -->
  <div
    class="float-slow absolute -left-6 top-10 z-20 hidden w-60 rounded-2xl rounded-bl-sm bg-white p-3.5 text-sm shadow-xl ring-1 shadow-slate-900/10 ring-slate-900/5 sm:block lg:-left-24"
  >
    <div class="mb-1.5 flex items-center gap-2 text-xs font-medium text-slate-500">
      <span class="grid size-5 place-items-center rounded-full bg-[#d97757] text-[10px] font-bold text-white">C</span>
      Claude
    </div>
    <p class="text-slate-700">Sending Tania a WhatsApp that you'll be 10 minutes late.</p>
  </div>

  <!-- Phone frame -->
  <div class="relative rounded-[3rem] bg-slate-900 p-3 shadow-2xl ring-1 shadow-brand-900/30 ring-slate-900/10">
    <div class="relative overflow-hidden rounded-[2.4rem] bg-slate-100">
      <!-- Status bar -->
      <div class="flex items-center justify-between px-7 pt-3 pb-2 text-[11px] font-semibold text-slate-700">
        <span>9:41</span>
        <span class="absolute left-1/2 top-2.5 h-5 w-5 -translate-x-1/2 rounded-full bg-slate-900"></span>
        <span class="flex items-center gap-1">
          <svg viewBox="0 0 16 12" class="h-2.5 w-3.5" fill="currentColor"><path d="M1 9h2v3H1zM5 6h2v6H5zM9 3h2v9H9zM13 0h2v12h-2z"></path></svg>
          <span class="inline-block h-2.5 w-5 rounded-[3px] border border-current p-px"><span class="block h-full w-3/4 rounded-[1px] bg-current"></span></span>
        </span>
      </div>

      <!-- Dimmed chat behind the sheet -->
      <div class="space-y-2 px-4 pt-3 pb-64 opacity-40 blur-[1px]">
        <div class="h-3 w-24 rounded bg-slate-300"></div>
        <div class="h-16 rounded-2xl bg-white"></div>
        <div class="h-16 rounded-2xl bg-white"></div>
        <div class="h-16 rounded-2xl bg-white"></div>
        <div class="h-16 rounded-2xl bg-white"></div>
      </div>

      <!-- Approval sheet -->
      <div class="absolute inset-x-0 bottom-0 rounded-t-3xl bg-white px-5 pt-3 pb-6 shadow-[0_-12px_40px_-12px_rgb(15_23_42/0.25)]">
        <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-slate-200"></div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 place-items-center rounded-xl bg-brand-600 text-white">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M7,1h10c1.1,0 2,0.9 2,2v18c0,1.1 -0.9,2 -2,2H7c-1.1,0 -2,-0.9 -2,-2V3c0,-1.1 0.9,-2 2,-2zM7,4v15h10V4H7zM9,9l2,2 -2,2 1,1 3,-3 -3,-3zM13,14h3v1.5h-3z"></path></svg>
          </span>
          <div>
            <p class="text-[11px] font-medium uppercase tracking-wide text-slate-400">DroidHands</p>
            <p class="text-sm font-semibold text-slate-900">Claude wants to</p>
          </div>
        </div>

        <div class="mt-4 rounded-2xl bg-slate-50 p-3.5 ring-1 ring-slate-100">
          <p class="text-sm font-semibold text-slate-900">Send WhatsApp to Tania Cohen</p>
          <p class="mt-0.5 text-xs text-slate-500">+972 54-•••-••12</p>
          <p class="mt-2.5 rounded-xl bg-[#dcf8c6] px-3 py-2 text-sm text-slate-800">“I'll be 10 minutes late”</p>
        </div>

        <div class="mt-4 grid grid-cols-2 gap-2.5">
          <span class="rounded-full bg-slate-100 py-2.5 text-center text-sm font-semibold text-slate-700">Deny</span>
          <span class="pulse-ring rounded-full bg-brand-600 py-2.5 text-center text-sm font-semibold text-white">Allow</span>
        </div>
        <p class="mt-3 text-center text-[11px] text-slate-400">Auto-denies in 60 s · requires unlocked phone</p>
      </div>
    </div>
  </div>
</div>
