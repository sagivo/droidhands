---
// The approval prompt the app shows before a sensitive action, recreated in HTML
// and animated as one looping story: the agent asks, the sheet slides up, you tap
// Allow, the message is sent, the sheet dismisses. 14s per cycle, no JS.
---

<div class="relative mx-auto w-full max-w-[340px]">
  <!-- Ambient glow behind the phone -->
  <div class="glow-drift absolute -inset-10 -z-10 rounded-full bg-brand-600/20 blur-3xl"></div>

  <!-- Agent request bubble -->
  <div class="float-slow absolute -left-6 top-10 z-20 hidden sm:block lg:-left-24">
    <div class="mock-bubble w-60 rounded-2xl rounded-bl-sm bg-ink-850 p-3.5 text-sm shadow-2xl shadow-black/40 ring-1 ring-white/10">
      <div class="mb-1.5 flex items-center gap-2 text-xs font-medium text-slate-400">
        <span class="grid size-5 place-items-center rounded-full bg-agent-500 text-[10px] font-bold text-white">C</span>
        Claude
      </div>
      <p class="text-slate-200">Sending Tania a WhatsApp that you'll be 10 minutes late.</p>
      <p class="mock-needs-approval mt-2 font-mono text-[10px] tracking-wide text-brand-300">needs your approval</p>
    </div>
  </div>

  <!-- Phone frame -->
  <div class="relative rounded-[3rem] bg-gradient-to-b from-ink-600 to-ink-950 p-3 shadow-[0_40px_80px_-24px_rgb(0_0_0/0.7),0_0_60px_-12px_rgb(111_102_247/0.35)] ring-1 ring-white/10">
    <div class="relative overflow-hidden rounded-[2.4rem] bg-ink-900">
      <!-- Status bar -->
      <div class="flex items-center justify-between px-7 pt-3 pb-2 text-[11px] font-semibold text-slate-200">
        <span>9:41</span>
        <span class="absolute left-1/2 top-2.5 h-5 w-5 -translate-x-1/2 rounded-full bg-black ring-1 ring-white/10"></span>
        <span class="flex items-center gap-1">
          <svg viewBox="0 0 16 12" class="h-2.5 w-3.5" fill="currentColor"><path d="M1 9h2v3H1zM5 6h2v6H5zM9 3h2v9H9zM13 0h2v12h-2z"></path></svg>
          <span class="inline-block h-2.5 w-5 rounded-[3px] border border-current p-px"><span class="block h-full w-3/4 rounded-[1px] bg-current"></span></span>
        </span>
      </div>

      <!-- Dimmed chat behind the sheet -->
      <div class="space-y-2 px-4 pt-3 pb-64 opacity-40 blur-[1px]">
        <div class="h-3 w-24 rounded bg-white/20"></div>
        <div class="h-16 rounded-2xl bg-white/10"></div>
        <div class="h-16 rounded-2xl bg-white/10"></div>
        <div class="h-16 rounded-2xl bg-white/10"></div>
        <div class="h-16 rounded-2xl bg-white/10"></div>
      </div>

      <!-- Approval sheet -->
      <div class="mock-sheet absolute inset-x-0 bottom-0 rounded-t-3xl bg-ink-850 px-5 pt-3 pb-6 shadow-[0_-24px_60px_-12px_rgb(0_0_0/0.6)] ring-1 ring-white/10">
        <div class="mx-auto mb-4 h-1 w-10 rounded-full bg-white/15"></div>
        <div class="flex items-center gap-2.5">
          <span class="grid size-9 place-items-center rounded-xl bg-brand-500 text-white shadow-lg shadow-brand-500/30">
            <svg viewBox="0 0 24 24" class="size-5" fill="currentColor"><path d="M7,1h10c1.1,0 2,0.9 2,2v18c0,1.1 -0.9,2 -2,2H7c-1.1,0 -2,-0.9 -2,-2V3c0,-1.1 0.9,-2 2,-2zM7,4v15h10V4H7zM9,9l2,2 -2,2 1,1 3,-3 -3,-3zM13,14h3v1.5h-3z"></path></svg>
          </span>
          <div>
            <p class="text-[11px] font-medium tracking-wide text-slate-400 uppercase">DroidHands</p>
            <p class="text-sm font-semibold text-white">Claude wants to</p>
          </div>
        </div>

        <div class="mt-4 rounded-2xl bg-white/[0.04] p-3.5 ring-1 ring-white/[0.07]">
          <p class="text-sm font-semibold text-white">Send WhatsApp to Tania Cohen</p>
          <p class="mt-0.5 font-mono text-xs text-slate-400">+972 54-•••-••12</p>
          <p class="mt-2.5 rounded-xl rounded-tr-none bg-[#005c4b] px-3 py-2 text-sm text-emerald-50">“I'll be 10 minutes late”</p>
        </div>

        <!-- Auto-deny countdown -->
        <div class="mt-4 h-0.5 overflow-hidden rounded-full bg-white/10">
          <div class="mock-timer h-full rounded-full bg-brand-400"></div>
        </div>

        <div class="relative mt-3.5">
          <div class="mock-buttons grid grid-cols-2 gap-2.5">
            <span class="rounded-full bg-white/[0.07] py-2.5 text-center text-sm font-semibold text-slate-300 ring-1 ring-white/10">Deny</span>
            <span class="mock-allow relative rounded-full bg-brand-500 py-2.5 text-center text-sm font-semibold text-white">Allow</span>
          </div>

          <!-- Success state, cross-faded over the buttons after the tap -->
          <div class="mock-success absolute inset-0 grid grid-cols-1 place-items-center">
            <span class="flex items-center gap-2 rounded-full bg-emerald-500/15 px-5 py-2.5 text-sm font-semibold text-emerald-300 ring-1 ring-emerald-400/30">
              <svg viewBox="0 0 24 24" class="size-4" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                <path class="mock-check" d="M20 6 9 17l-5-5" pathLength="24" />
              </svg>
              Allowed · message sent
            </span>
          </div>
        </div>
        <p class="mock-note mt-3 text-center text-[11px] text-slate-500">Auto-denies in 60 s · requires unlocked phone</p>
      </div>

      <!-- Tap ripple over the Allow button -->
      <span class="mock-tap pointer-events-none absolute bottom-[64px] left-[73%] z-10 size-9 rounded-full bg-brand-300/50 ring-4 ring-brand-200/40"></span>
    </div>
  </div>
</div>

<style>
  /* Base (reduced-motion) state: everything visible, nothing moving. */
  .mock-tap,
  .mock-success {
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .mock-bubble { animation: mock-bubble 14s var(--ease-out-soft) infinite; }
    .mock-needs-approval { animation: mock-label 14s linear infinite; }
    .mock-sheet { animation: mock-sheet 14s var(--ease-out-soft) infinite; }
    .mock-allow { animation: mock-pulse 14s ease-out infinite; }
    .mock-tap { animation: mock-tap 14s ease-out infinite; }
    .mock-buttons { animation: mock-buttons 14s linear infinite; }
    .mock-success { animation: mock-success 14s var(--ease-out-soft) infinite; }
    .mock-check { animation: mock-check 14s ease-out infinite; stroke-dasharray: 24; }
    .mock-timer { animation: mock-timer 14s linear infinite; }
    .mock-note { animation: mock-note 14s linear infinite; }
  }

  /* 1 Agent asks. */
  @keyframes mock-bubble {
    0% { opacity: 0; transform: translateY(12px) scale(0.94); }
    5%, 80% { opacity: 1; transform: none; }
    87%, 100% { opacity: 0; transform: translateY(-8px); }
  }
  @keyframes mock-label {
    0%, 5% { opacity: 0; }
    9%, 46% { opacity: 1; }
    50%, 100% { opacity: 0; }
  }

  /* 2 Sheet slides up, waits, slides back down. */
  @keyframes mock-sheet {
    0%, 9% { transform: translateY(103%); }
    17%, 71% { transform: translateY(0); }
    80%, 100% { transform: translateY(103%); }
  }

  /* 3 Allow pulses until you tap it. */
  @keyframes mock-pulse {
    0%, 22% { box-shadow: 0 0 0 0 rgb(111 102 247 / 0); }
    26% { box-shadow: 0 0 0 0 rgb(111 102 247 / 0.5); }
    36% { box-shadow: 0 0 0 14px rgb(111 102 247 / 0); }
    40% { box-shadow: 0 0 0 0 rgb(111 102 247 / 0.5); }
    50%, 100% { box-shadow: 0 0 0 0 rgb(111 102 247 / 0); }
  }
  @keyframes mock-timer {
    0%, 18% { width: 100%; opacity: 0; }
    20% { opacity: 1; }
    48% { width: 45%; opacity: 1; }
    52% { width: 40%; opacity: 0; }
    100% { width: 0%; opacity: 0; }
  }

  /* 4 The tap, then the buttons hand over to the success chip. */
  @keyframes mock-tap {
    0%, 46% { opacity: 0; transform: translate(-50%, 0) scale(2.4); }
    48% { opacity: 1; transform: translate(-50%, 0) scale(1); }
    53%, 100% { opacity: 0; transform: translate(-50%, 0) scale(0.9); }
  }
  @keyframes mock-buttons {
    0%, 52% { opacity: 1; }
    55%, 74% { opacity: 0; }
    78%, 100% { opacity: 1; }
  }
  @keyframes mock-success {
    0%, 52% { opacity: 0; transform: scale(0.9); }
    57%, 72% { opacity: 1; transform: scale(1); }
    77%, 100% { opacity: 0; }
  }
  @keyframes mock-check {
    0%, 54% { stroke-dashoffset: 24; }
    60%, 100% { stroke-dashoffset: 0; }
  }
  @keyframes mock-note {
    0%, 52% { opacity: 1; }
    55%, 74% { opacity: 0; }
    78%, 100% { opacity: 1; }
  }
</style>
