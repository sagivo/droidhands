---
// Animated examples of an agent running routines and one-off requests on the phone.
// Elements with data-at="N" are visible from step N until data-until (exclusive);
// [data-type] elements type out their data-text at step data-type-at. The script below
// walks each scenario's `plan` (the delay before each step, in ms).
import Tap from "./Tap.astro";
import RunBox from "./RunBox.astro";

type LogLine = { at: number; doneAt?: number; name: string; args: string; result: string };
type Scenario = {
  id: "morning" | "email" | "call" | "bedtime";
  tab: string;
  icon: string;
  prompt: string;
  routine?: { title: string; schedule: string; reply: string };
  warp?: { label: string; time: string; date: string };
  run: [number, number];
  log: LogLine[];
  final: { at: number; text: string };
  plan: number[];
};

const typeMs = (text: string) => text.length * 38;

const whatsappText = "Leaving now, at the office in about 12 minutes";
const emailText = "Thursday at 3 works. See you then!";

const prompts = {
  morning: "Every weekday at 8:30, WhatsApp Tania my ETA to the office",
  email: "Reply to Dan's email: Thursday at 3 works",
  call: "Call mom and put her on speaker",
  bedtime: "Every night at 11, silence my phone and set a 7:00 alarm",
};

const scenarios: Scenario[] = [
  {
    id: "morning",
    tab: "Morning ETA",
    icon: "sun",
    prompt: prompts.morning,
    routine: { title: "WhatsApp Tania my ETA", schedule: "Weekdays · 8:30 AM", reply: "Done. I'll send it every weekday at 8:30." },
    warp: { label: "Next morning · 8:30 AM", time: "8:30", date: "Friday, November 15" },
    run: [5, 10],
    log: [
      { at: 5, name: "location_get", args: "", result: "12 min to office" },
      { at: 6, doneAt: 9, name: "whatsapp_send", args: 'contact: "Tania Cohen"', result: "sent" },
    ],
    final: { at: 10, text: "Sent Tania your ETA: about 12 minutes." },
    plan: [400, typeMs(prompts.morning) + 400, 1000, 1700, 1300, 1100, 700, typeMs(whatsappText) + 300, 350, 1000],
  },
  {
    id: "email",
    tab: "Reply to email",
    icon: "mail",
    prompt: prompts.email,
    run: [3, 10],
    log: [
      { at: 3, name: "notifications_list", args: 'query: "Dan"', result: "1 email" },
      { at: 4, name: "ui_tap", args: 'text: "Dan Levi"', result: "opened" },
      { at: 6, name: "ui_tap", args: 'text: "Reply"', result: "ok" },
      { at: 7, doneAt: 8, name: "ui_type", args: '"Thursday at 3 works…"', result: "typed" },
      { at: 8, doneAt: 9, name: "ui_tap", args: 'text: "Send"', result: "sent" },
    ],
    final: { at: 10, text: "Replied to Dan: Thursday at 3 works." },
    plan: [400, typeMs(prompts.email) + 400, 900, 1000, 500, 1000, 600, typeMs(emailText) + 300, 400, 900],
  },
  {
    id: "call",
    tab: "Call mom",
    icon: "phone",
    prompt: prompts.call,
    run: [3, 8],
    log: [
      { at: 3, name: "contacts_search", args: 'query: "Mom"', result: "+1 415-555-0142" },
      { at: 4, doneAt: 5, name: "phone_call", args: 'contact: "Mom"', result: "connected" },
      { at: 6, doneAt: 7, name: "ui_tap", args: 'text: "Speaker"', result: "on" },
    ],
    final: { at: 8, text: "You're on speaker with Mom." },
    plan: [400, typeMs(prompts.call) + 400, 900, 1000, 1800, 1000, 350, 800],
  },
  {
    id: "bedtime",
    tab: "Bedtime",
    icon: "moon",
    prompt: prompts.bedtime,
    routine: { title: "Silence phone, set a 7:00 alarm", schedule: "Every day · 11:00 PM", reply: "Got it. I'll do this every night at 11." },
    warp: { label: "Tonight · 11:00 PM", time: "11:00", date: "Thursday, November 14" },
    run: [5, 10],
    log: [
      { at: 5, doneAt: 7, name: "ringer_mode_set", args: 'mode: "silent"', result: "silent" },
      { at: 8, doneAt: 9, name: "alarm_set", args: "hour: 7, minute: 0", result: "set" },
    ],
    final: { at: 10, text: "Phone silenced and alarm set for 7:00. Good night." },
    plan: [400, typeMs(prompts.bedtime) + 400, 1000, 1700, 1300, 1000, 350, 1000, 700, 1000],
  },
];

const icons: Record<string, string> = {
  sun: '<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"/>',
  moon: '<path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"/>',
  mail: '<rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/>',
  phone: '<path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.910a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/>',
  clock: '<circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>',
  sparkle: '<path d="M12 3l1.9 5.8L20 10.7l-6.1 1.9L12 18.5l-1.9-5.9L4 10.7l6.1-1.9z"/>',
  wifi: '<path d="M5 12.55a11 11 0 0 1 14.08 0M1.42 9a16 16 0 0 1 21.16 0M8.53 16.11a6 6 0 0 1 6.95 0M12 20h.01"/>',
  bluetooth: '<path d="m7 7 10 10-5 5V2l5 5L7 17"/>',
  bellOff: '<path d="M8.7 3A6 6 0 0 1 18 8a21.3 21.3 0 0 0 .6 5M17 17H3s3-2 3-9a4.67 4.67 0 0 1 .3-1.7M10.3 21a1.94 1.94 0 0 0 3.4 0M2 2l20 20"/>',
  flashlight: '<path d="M18 6c0 2-2 2-2 4v10a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2V10c0-2-2-2-2-4V2h12zM6 6h12"/>',
  plane: '<path d="M17.8 19.2 16 11l3.5-3.5C21 6 21.5 4 21 3c-1-.5-3 0-4.5 1.5L13 8 4.8 6.2c-.5-.1-.9.1-1.1.5l-.3.5c-.2.5-.1 1 .3 1.3L9 12l-2 3H4l-1 1 3 2 2 3 1-1v-3l3-2 3.5 5.3c.3.4.8.5 1.3.3l.5-.2c.4-.3.6-.7.5-1.2z"/>',
  battery: '<rect width="16" height="10" x="2" y="7" rx="2"/><path d="M22 11v2M6 11v2"/>',
  speaker: '<path d="M11 5 6 9H2v6h4l5 4V5zM15.54 8.46a5 5 0 0 1 0 7.07M19.07 4.93a10 10 0 0 1 0 14.14"/>',
};

const svg = (name: string, cls = "size-4") =>
  `<svg viewBox="0 0 24 24" class="${cls}" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">${icons[name]}</svg>`;
---

<div data-demo class="mx-auto max-w-5xl">
  <div role="tablist" aria-label="Examples" class="mx-auto flex w-fit max-w-full gap-1 overflow-x-auto rounded-full bg-slate-100 p-1">
    {
      scenarios.map((s, i) => (
        <button
          type="button"
          role="tab"
          data-tab={i}
          aria-selected={i === 0 ? "true" : "false"}
          class="relative flex shrink-0 items-center gap-2 overflow-hidden rounded-full px-4 py-2 text-sm font-medium text-slate-600 transition hover:text-slate-900 aria-selected:bg-white aria-selected:text-slate-900 aria-selected:shadow-sm"
        >
          <Fragment set:html={svg(s.icon)} />
          {s.tab}
          <span data-progress class="absolute inset-x-3 bottom-0.5 h-0.5 origin-left scale-x-0 rounded-full bg-brand-500" />
        </button>
      ))
    }
  </div>

  {
    scenarios.map((s, i) => (
      <div data-scenario={s.id} data-plan={JSON.stringify(s.plan)} hidden={i !== 0} class="mt-10 grid items-center gap-10 md:grid-cols-[1fr_auto] md:gap-14">
        {/* Agent side */}
        <div class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 shadow-slate-900/5 ring-slate-900/5">
          <div class="flex items-center gap-3 border-b border-slate-100 px-5 py-3.5">
            <span class="flex gap-1.5">
              <span class="size-2.5 rounded-full bg-slate-200" />
              <span class="size-2.5 rounded-full bg-slate-200" />
              <span class="size-2.5 rounded-full bg-slate-200" />
            </span>
            <span class="ml-2 flex items-center gap-2 text-sm font-medium text-slate-700">
              <span class="grid size-5 place-items-center rounded-full bg-[#d97757] text-[10px] font-bold text-white">C</span>
              Claude
            </span>
            <span class="ml-auto rounded-full bg-emerald-50 px-2 py-0.5 text-[11px] font-medium text-emerald-700">phone connected</span>
          </div>

          <div class="min-h-[440px] space-y-3 p-5">
            <div data-at="1" class="flex justify-end">
              <p class="max-w-[85%] rounded-2xl rounded-br-sm bg-brand-600 px-4 py-2.5 text-[15px] text-white">
                <span data-type data-type-at="1" data-text={s.prompt} />
                <span class="caret ml-px h-4 w-0.5 translate-y-0.5 bg-white/80" />
              </p>
            </div>

            <div class="grid">
              <div data-at="2" data-until="3" class="col-start-1 row-start-1 flex h-fit w-fit gap-1 rounded-2xl bg-slate-100 px-4 py-3">
                <span class="dot size-1.5 rounded-full bg-slate-400" />
                <span class="dot size-1.5 rounded-full bg-slate-400 [animation-delay:150ms]" />
                <span class="dot size-1.5 rounded-full bg-slate-400 [animation-delay:300ms]" />
              </div>

              {s.routine ? (
                <div data-at="3" class="col-start-1 row-start-1 space-y-2.5">
                  <div class="flex items-center gap-3 rounded-2xl bg-brand-50 p-3 ring-1 ring-brand-100">
                    <span class="grid size-10 shrink-0 place-items-center rounded-xl bg-brand-600 text-white">
                      <Fragment set:html={svg("clock", "size-5")} />
                    </span>
                    <div class="min-w-0">
                      <p class="text-[11px] font-semibold uppercase tracking-wide text-brand-600">Routine saved</p>
                      <p class="truncate text-sm font-semibold text-slate-900">{s.routine.title}</p>
                      <p class="text-xs text-slate-500">{s.routine.schedule}</p>
                    </div>
                    <span class="ml-auto shrink-0 rounded-full bg-white px-2 py-0.5 text-[11px] font-medium text-emerald-700 ring-1 ring-emerald-100">On</span>
                  </div>
                  <p class="flex gap-2.5 text-[15px] text-slate-700">
                    <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-[#d97757] text-[10px] font-bold text-white">C</span>
                    {s.routine.reply}
                  </p>
                </div>
              ) : (
                <RunBox run={s.run} log={s.log} />
              )}
            </div>

            {s.warp && (
              <>
                <div data-at="4" data-fx="fade" class="flex items-center gap-3 py-1 text-xs font-medium">
                  <span class="h-px flex-1 bg-gradient-to-r from-transparent to-slate-300" />
                  <span class="warp flex items-center gap-1.5 rounded-full px-3 py-1 text-white">
                    <Fragment set:html={svg(s.id === "bedtime" ? "moon" : "sun", "size-3.5")} />
                    {s.warp.label}
                  </span>
                  <span class="h-px flex-1 bg-gradient-to-l from-transparent to-slate-300" />
                </div>
                <RunBox run={s.run} log={s.log} />
              </>
            )}

            <div data-at={s.final.at} class="flex gap-2.5">
              <span class="mt-0.5 grid size-6 shrink-0 place-items-center rounded-full bg-[#d97757] text-[10px] font-bold text-white">C</span>
              <p class="text-[15px] text-slate-700">{s.final.text}</p>
            </div>
          </div>
        </div>

        {/* Phone side */}
        <div class="relative isolate mx-auto w-[280px]">
          <div data-at={s.run[0]} data-until={s.run[1]} data-fx="fade" class="ai-glow absolute -inset-1.5 -z-10 rounded-[3.2rem]" />
          <div class="rounded-[2.75rem] bg-slate-900 p-2.5 shadow-2xl ring-1 shadow-brand-900/30 ring-slate-900/10">
            <div class="relative h-[560px] overflow-hidden rounded-[2.25rem] bg-gradient-to-br from-brand-400 via-brand-600 to-slate-900">
              {/* Status bar */}
              <div data-statusbar class="absolute inset-x-0 top-0 z-50 flex items-center justify-between px-6 pt-2.5 text-[11px] font-semibold text-white transition-colors duration-300">
                <span class="grid">
                  <span data-at="0" data-until={s.warp ? 4 : 99} data-fx="fade" class="col-start-1 row-start-1">9:41</span>
                  {s.warp && <span data-at="4" data-fx="fade" class="col-start-1 row-start-1">{s.warp.time}</span>}
                </span>
                <span class="absolute left-1/2 top-2 size-4 -translate-x-1/2 rounded-full bg-black" />
                <span class="flex items-center gap-1">
                  <svg viewBox="0 0 16 12" class="h-2.5 w-3.5" fill="currentColor"><path d="M1 9h2v3H1zM5 6h2v6H5zM9 3h2v9H9zM13 0h2v12h-2z" /></svg>
                  <span class="inline-block h-2.5 w-5 rounded-[3px] border border-current p-px"><span class="block h-full w-3/4 rounded-[1px] bg-current" /></span>
                </span>
              </div>

              {/* "Claude is using your phone" */}
              <div data-at={s.run[0]} data-until={s.run[1]} data-fx="island" class="absolute inset-x-0 top-1.5 z-[60] flex justify-center">
                <span class="flex h-[22px] items-center gap-1.5 rounded-full bg-black pr-3 pl-2 text-[10px] font-medium text-white">
                  <span class="sparkle text-amber-300"><Fragment set:html={svg("sparkle", "size-3")} /></span>
                  Claude is working
                </span>
              </div>
              <div data-at={s.run[0]} data-until={s.run[1]} data-fx="fade" class="edge-glow pointer-events-none absolute inset-0 z-40 rounded-[2.25rem]" />

              {/* Lock screen */}
              <div class="absolute inset-0 px-5 pt-20 text-center text-white">
                <div class="grid">
                  <div data-at="0" data-until={s.warp ? 4 : 99} data-fx="fade" class="col-start-1 row-start-1">
                    <p class="text-sm font-medium text-white/80">Thursday, November 14</p>
                    <p class="text-7xl font-semibold tracking-tight">9:41</p>
                  </div>
                  {s.warp && (
                    <div data-at="4" data-fx="flip" class="col-start-1 row-start-1">
                      <p class="text-sm font-medium text-white/80">{s.warp.date}</p>
                      <p class="text-7xl font-semibold tracking-tight">{s.warp.time}</p>
                    </div>
                  )}
                </div>
                {s.id === "email" && (
                  <div data-at="1" data-fx="pop" class="relative mt-8 rounded-2xl bg-white/85 p-3 text-left text-slate-800 shadow-lg backdrop-blur">
                    <p class="flex items-center gap-1.5 text-[11px] text-slate-500">
                      <span class="grid size-4 place-items-center rounded bg-rose-500 text-[8px] font-bold text-white">M</span> Gmail · now
                    </p>
                    <p class="mt-1 text-sm font-semibold">Dan Levi</p>
                    <p class="text-xs text-slate-600">Design review: can we move it to Thursday?</p>
                    <Tap at={4} />
                  </div>
                )}
              </div>

              {/* Morning: WhatsApp */}
              {s.id === "morning" && (
                <div data-at="6" data-fx="push" class="absolute inset-0 z-10 flex flex-col bg-[#efeae2]">
                  <div class="flex items-center gap-2.5 bg-[#008069] px-4 pt-9 pb-3 text-white">
                    <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6" /></svg>
                    <span class="grid size-8 place-items-center rounded-full bg-pink-300 text-sm font-semibold text-pink-900">T</span>
                    <div>
                      <p class="text-sm font-semibold">Tania Cohen</p>
                      <p class="text-[11px] text-white/75">online</p>
                    </div>
                  </div>
                  <div class="flex flex-1 flex-col justify-end gap-2 p-3 text-[13px]">
                    <p class="mx-auto mb-1 rounded-md bg-white/70 px-2 py-0.5 text-[10px] text-slate-500">YESTERDAY</p>
                    <p class="ml-auto max-w-[80%] rounded-lg rounded-tr-none bg-[#d9fdd3] px-2.5 py-1.5 text-slate-800 shadow-sm">
                      Leaving now, at the office in about 15 minutes <span class="ml-1 text-[10px] text-slate-400">8:30</span>
                    </p>
                    <p class="max-w-[80%] rounded-lg rounded-tl-none bg-white px-2.5 py-1.5 text-slate-800 shadow-sm">
                      Coffee's on me <span class="ml-1 text-[10px] text-slate-400">8:34</span>
                    </p>
                    <p class="mx-auto my-1 rounded-md bg-white/70 px-2 py-0.5 text-[10px] text-slate-500">TODAY</p>
                    <p data-at="9" data-fx="pop" class="ml-auto flex max-w-[80%] items-end gap-1 rounded-lg rounded-tr-none bg-[#d9fdd3] px-2.5 py-1.5 text-slate-800 shadow-sm">
                      {whatsappText}
                      <span class="ml-1 flex shrink-0 items-center gap-0.5 text-[10px] text-slate-400">
                        8:30
                        <span class="grid">
                          <svg data-at="9" data-until="10" data-fx="fade" viewBox="0 0 16 11" class="col-start-1 row-start-1 h-2.5 w-3.5" fill="none" stroke="#94a3b8" stroke-width="1.6"><path d="m1 6 3 3 6-7M6 9l1 1 7-8" /></svg>
                          <svg data-at="10" data-fx="fade" viewBox="0 0 16 11" class="col-start-1 row-start-1 h-2.5 w-3.5" fill="none" stroke="#53bdeb" stroke-width="1.6"><path d="m1 6 3 3 6-7M6 9l1 1 7-8" /></svg>
                        </span>
                      </span>
                    </p>
                  </div>
                  <div class="flex items-end gap-2 p-2">
                    <div class="grid min-h-9 flex-1 items-center rounded-3xl bg-white px-4 py-2 text-[13px] leading-snug text-slate-800">
                      <span data-at="0" data-until="7" data-fx="fade" class="col-start-1 row-start-1 text-slate-400">Message</span>
                      <span data-at="7" data-until="9" data-fx="fade" class="col-start-1 row-start-1">
                        <span data-type data-type-at="7" data-text={whatsappText} />
                        <span class="caret ml-px h-3.5 w-0.5 translate-y-0.5 bg-[#008069]" />
                      </span>
                      <span data-at="9" data-fx="fade" class="col-start-1 row-start-1 text-slate-400">Message</span>
                    </div>
                    <span class="relative grid size-9 shrink-0 place-items-center rounded-full bg-[#008069] text-white">
                      <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" /></svg>
                      <Tap at={8} />
                    </span>
                  </div>
                </div>
              )}

              {/* Email: Gmail thread, then compose */}
              {s.id === "email" && (
                <>
                  <div data-at="5" data-fx="push" data-light class="absolute inset-0 z-10 flex flex-col bg-white">
                    <div class="flex items-center gap-3 px-4 pt-10 pb-2 text-slate-600">
                      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="m15 18-6-6 6-6" /></svg>
                      <span class="ml-auto size-4 rounded bg-slate-200" />
                      <span class="size-4 rounded bg-slate-200" />
                    </div>
                    <p class="px-5 pt-2 text-lg font-semibold text-slate-900">
                      Design review <span class="ml-1 rounded bg-slate-100 px-1.5 py-0.5 align-middle text-[10px] font-medium text-slate-500">Inbox</span>
                    </p>
                    <div class="mt-4 space-y-3 px-4 text-[13px]">
                      <div class="flex gap-3">
                        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-sky-500 text-sm font-semibold text-white">D</span>
                        <div>
                          <p class="font-semibold text-slate-900">Dan Levi <span class="font-normal text-slate-400">· 9:40</span></p>
                          <p class="mt-1 text-slate-600">Hi! Something came up on Wednesday. Can we move the design review to Thursday?</p>
                        </div>
                      </div>
                      <div data-at="9" data-fx="pop" class="flex gap-3 rounded-2xl bg-brand-50 p-3">
                        <span class="grid size-8 shrink-0 place-items-center rounded-full bg-brand-600 text-sm font-semibold text-white">Y</span>
                        <div>
                          <p class="font-semibold text-slate-900">You <span class="font-normal text-slate-400">· now</span></p>
                          <p class="mt-1 text-slate-700">{emailText}</p>
                        </div>
                      </div>
                    </div>
                    <div class="mt-auto flex gap-2 px-4 pb-6">
                      <span class="relative flex-1 rounded-full border border-slate-300 py-2 text-center text-sm font-medium text-slate-700">
                        Reply
                        <Tap at={6} />
                      </span>
                      <span class="flex-1 rounded-full border border-slate-300 py-2 text-center text-sm font-medium text-slate-700">Forward</span>
                    </div>
                  </div>
                  <div data-at="7" data-until="9" data-fx="sheet" class="absolute inset-x-0 bottom-0 z-20 h-[62%] rounded-t-3xl bg-white px-5 pt-4 shadow-[0_-12px_40px_-12px_rgb(15_23_42/0.3)]">
                    <div class="flex items-center justify-between">
                      <p class="text-sm font-semibold text-slate-900">Reply</p>
                      <span class="relative grid size-8 place-items-center rounded-full bg-brand-600 text-white">
                        <svg viewBox="0 0 24 24" class="size-4" fill="currentColor"><path d="M3.4 20.4 21 12 3.4 3.6 3.4 10l12.6 2-12.6 2z" /></svg>
                        <Tap at={8} />
                      </span>
                    </div>
                    <p class="mt-3 border-b border-slate-100 pb-2 text-xs text-slate-500">To <span class="ml-1 rounded-full bg-slate-100 px-2 py-0.5 text-slate-700">Dan Levi</span></p>
                    <p class="border-b border-slate-100 py-2 text-xs text-slate-500">Re: Design review</p>
                    <p class="pt-3 text-[14px] text-slate-800">
                      <span data-type data-type-at="7" data-text={emailText} />
                      <span class="caret ml-px h-4 w-0.5 translate-y-0.5 bg-brand-600" />
                    </p>
                  </div>
                  <div data-at="9" class="absolute inset-x-4 bottom-20 z-30 flex items-center justify-between rounded-xl bg-slate-900 px-4 py-3 text-sm text-white shadow-lg">
                    Sent
                    <span class="font-semibold text-brand-300">Undo</span>
                  </div>
                </>
              )}

              {/* Call */}
              {s.id === "call" && (
                <div data-at="4" data-fx="screen" class="absolute inset-0 z-10 flex flex-col items-center bg-gradient-to-b from-slate-800 to-slate-950 px-6 pt-24 pb-10 text-white">
                  <div class="relative grid size-24 place-items-center">
                    <span class="ring-pulse absolute inset-0 rounded-full bg-emerald-400/30" />
                    <span class="ring-pulse absolute inset-0 rounded-full bg-emerald-400/30 [animation-delay:1s]" />
                    <span class="relative grid size-24 place-items-center rounded-full bg-gradient-to-br from-amber-300 to-rose-400 text-3xl font-semibold">M</span>
                  </div>
                  <p class="mt-6 text-2xl font-semibold">Mom</p>
                  <div class="mt-1 grid text-sm text-white/60">
                    <span data-at="4" data-until="5" data-fx="fade" class="col-start-1 row-start-1 text-center">Calling…</span>
                    <span data-at="5" data-fx="fade" data-timer data-timer-at="5" class="col-start-1 row-start-1 text-center tabular-nums">00:00</span>
                  </div>
                  <div class="mt-auto grid w-full grid-cols-3 gap-y-6 text-center text-[11px] text-white/70">
                    <span class="flex flex-col items-center gap-1.5"><span class="size-12 rounded-full bg-white/10" />Mute</span>
                    <span class="flex flex-col items-center gap-1.5"><span class="size-12 rounded-full bg-white/10" />Keypad</span>
                    <span class="flex flex-col items-center gap-1.5">
                      <span class="relative grid size-12 place-items-center rounded-full bg-white/10">
                        <span data-at="7" data-fx="fade" class="absolute inset-0 rounded-full bg-white" />
                        <span class="relative grid">
                          <span data-at="0" data-until="7" data-fx="fade" class="col-start-1 row-start-1 text-white"><Fragment set:html={svg("speaker", "size-5")} /></span>
                          <span data-at="7" data-fx="fade" class="col-start-1 row-start-1 text-slate-900"><Fragment set:html={svg("speaker", "size-5")} /></span>
                        </span>
                        <Tap at={6} />
                      </span>
                      Speaker
                    </span>
                    <span class="col-start-2 grid size-14 place-items-center justify-self-center rounded-full bg-rose-500">
                      <svg viewBox="0 0 24 24" class="size-6 rotate-[135deg]" fill="white"><path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1 1 0 0 0-1.02.24l-2.2 2.2a15.05 15.05 0 0 1-6.590-6.59l2.2-2.2a1 1 0 0 0 .25-1.020A11.36 11.36 0 0 1 8.5 4a1 1 0 0 0-1-1H4a1 1 0 0 0-1 1 17 17 0 0 0 17 17 1 1 0 0 0 1-1v-3.5a1 1 0 0 0-1-1z" /></svg>
                    </span>
                  </div>
                </div>
              )}

              {/* Bedtime: quick settings, then Clock */}
              {s.id === "bedtime" && (
                <>
                  <div data-at="5" data-until="8" data-fx="fade" class="absolute inset-0 z-10 bg-slate-950/50" />
                  <div data-at="5" data-until="8" data-fx="drop" class="absolute inset-x-0 top-0 z-20 rounded-b-3xl bg-slate-900 px-4 pt-10 pb-5 text-white">
                    <div class="mb-4 h-8 rounded-full bg-white/10 p-1">
                      <div class="h-full w-2/5 rounded-full bg-brand-300/80" />
                    </div>
                    <div class="grid grid-cols-2 gap-2 text-xs font-medium">
                      {[
                        { label: "Wi-Fi", sub: "Home", icon: "wifi" },
                        { label: "Bluetooth", sub: "On", icon: "bluetooth" },
                      ].map((t) => (
                        <span class="flex items-center gap-2 rounded-2xl bg-brand-200 px-3 py-3 text-slate-900">
                          <Fragment set:html={svg(t.icon)} />
                          <span>{t.label}<span class="block text-[10px] font-normal opacity-70">{t.sub}</span></span>
                        </span>
                      ))}
                      <span class="relative grid rounded-2xl">
                        <span data-at="0" data-until="7" data-fx="fade" class="col-start-1 row-start-1 flex items-center gap-2 rounded-2xl bg-white/10 px-3 py-3">
                          <Fragment set:html={svg("bellOff")} />
                          <span>Silent<span class="block text-[10px] font-normal opacity-70">Off</span></span>
                        </span>
                        <span data-at="7" data-fx="fade" class="col-start-1 row-start-1 flex items-center gap-2 rounded-2xl bg-brand-200 px-3 py-3 text-slate-900">
                          <Fragment set:html={svg("bellOff")} />
                          <span>Silent<span class="block text-[10px] font-normal opacity-70">On</span></span>
                        </span>
                        <Tap at={6} />
                      </span>
                      {[
                        { label: "Flashlight", icon: "flashlight" },
                        { label: "Airplane", icon: "plane" },
                        { label: "Saver", icon: "battery" },
                      ].map((t) => (
                        <span class="flex items-center gap-2 rounded-2xl bg-white/10 px-3 py-3">
                          <Fragment set:html={svg(t.icon)} />
                          <span>{t.label}<span class="block text-[10px] font-normal opacity-70">Off</span></span>
                        </span>
                      ))}
                    </div>
                  </div>

                  <div data-at="8" data-fx="push" class="absolute inset-0 z-30 flex flex-col bg-slate-950 px-5 pt-12 text-white">
                    <p class="text-2xl font-semibold">Alarm</p>
                    <div class="mt-5 space-y-2.5">
                      {[
                        { time: "6:30", days: "Mon–Fri", on: false, at: 0 },
                        { time: "7:00", days: "Every day", on: true, at: 9 },
                        { time: "9:00", days: "Sat, Sun", on: false, at: 0 },
                      ].map((a) => (
                        <div
                          data-at={a.at || undefined}
                          data-fx={a.at ? "pop" : undefined}
                          class={`flex items-center justify-between rounded-2xl px-4 py-3.5 ${a.on ? "bg-brand-600/30 ring-1 ring-brand-400/40" : "bg-white/5"}`}
                        >
                          <div>
                            <p class={`text-3xl font-light ${a.on ? "text-white" : "text-white/50"}`}>
                              {a.time}
                              <span class="ml-1 text-sm">AM</span>
                            </p>
                            <p class="text-xs text-white/50">{a.days}</p>
                          </div>
                          <span class={`relative h-6 w-10 rounded-full ${a.on ? "bg-brand-400" : "bg-white/15"}`}>
                            <span class={`absolute top-0.5 size-5 rounded-full bg-white ${a.on ? "left-[18px]" : "left-0.5"}`} />
                          </span>
                        </div>
                      ))}
                    </div>
                    <div data-at="9" class="mt-auto mb-6 rounded-xl bg-white px-4 py-3 text-sm text-slate-900 shadow-lg">Alarm set for 7:00 AM</div>
                  </div>
                </>
              )}
            </div>
          </div>
        </div>
      </div>
    ))
  }
</div>

<style is:global>
  [data-demo] [data-at] {
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.4s ease,
      transform 0.5s cubic-bezier(0.2, 0.9, 0.3, 1.2);
  }
  [data-demo] [data-at].on {
    opacity: 1;
    transform: none;
  }
  [data-demo] [data-fx="fade"] { transform: none; }
  [data-demo] [data-fx="pop"] { transform: scale(0.85); transform-origin: bottom right; }
  [data-demo] [data-fx="screen"] { transform: scale(1.04); }
  [data-demo] [data-fx="flip"] { transform: translateY(-14px) scale(0.96); }
  [data-demo] [data-fx="push"] {
    transform: translateX(45%);
    transition-duration: 0.3s, 0.45s;
    transition-timing-function: ease, cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  [data-demo] [data-fx="sheet"] {
    transform: translateY(100%);
    transition-timing-function: ease, cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  [data-demo] [data-fx="drop"] {
    transform: translateY(-100%);
    transition-timing-function: ease, cubic-bezier(0.2, 0.9, 0.25, 1);
  }
  [data-demo] [data-fx="island"] { transform: scaleX(0.12); }
  [data-demo] [data-fx="tap"] {
    transform: translate(-50%, -50%) scale(2.2);
    transition-duration: 0.15s, 0.3s;
  }
  [data-demo] [data-fx="tap"].on { transform: translate(-50%, -50%) scale(1); }
  [data-demo] .result.on { transition-delay: 0.35s; }

  [data-demo] [data-progress].run {
    transform: scaleX(1);
    transition: transform var(--dur, 10s) linear;
  }
  /* Dark status bar text while a white app screen is showing. */
  [data-demo] [data-scenario]:has([data-light].on) [data-statusbar] { color: var(--color-slate-800); }

  [data-demo] .caret { display: none; }
  [data-demo] [data-typing] .caret {
    display: inline-block;
    animation: demo-blink 1s steps(1) infinite;
  }

  @property --glow-angle {
    syntax: "<angle>";
    inherits: false;
    initial-value: 0deg;
  }
  [data-demo] .ai-glow {
    background: conic-gradient(from var(--glow-angle), #818cf8, #f0abfc, #fdba74, #67e8f9, #818cf8);
    filter: blur(14px);
    animation: demo-glow 3s linear infinite;
  }
  [data-demo] .edge-glow {
    box-shadow:
      inset 0 0 0 2px rgb(165 180 252 / 0.7),
      inset 0 0 28px 2px rgb(192 132 252 / 0.45);
    animation: demo-breathe 2s ease-in-out infinite;
  }
  [data-demo] .warp {
    background-image: linear-gradient(110deg, #0f172a 40%, #4f5fc6 50%, #0f172a 60%);
    background-size: 200% 100%;
    animation: demo-shimmer 1.8s linear infinite;
  }
  [data-demo] .sparkle { animation: demo-twinkle 1.4s ease-in-out infinite; }
  [data-demo] .dot { animation: demo-bounce 1s ease-in-out infinite; }
  [data-demo] .spin { animation: demo-spin 0.9s linear infinite; }
  [data-demo] .ring-pulse { animation: demo-ring 2s ease-out infinite; }

  @keyframes demo-blink { 50% { opacity: 0; } }
  @keyframes demo-glow { to { --glow-angle: 360deg; } }
  @keyframes demo-breathe { 50% { opacity: 0.55; } }
  @keyframes demo-shimmer { from { background-position: 100% 0; } to { background-position: -100% 0; } }
  @keyframes demo-twinkle { 50% { transform: rotate(20deg) scale(1.2); } }
  @keyframes demo-bounce {
    0%, 60%, 100% { transform: translateY(0); opacity: 0.5; }
    30% { transform: translateY(-4px); opacity: 1; }
  }
  @keyframes demo-spin { to { transform: rotate(360deg); } }
  @keyframes demo-ring {
    0% { transform: scale(1); opacity: 0.8; }
    100% { transform: scale(1.8); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-demo] [data-at],
    [data-demo] [data-at].on { transition: none; }
    [data-demo] .ai-glow,
    [data-demo] .edge-glow,
    [data-demo] .warp,
    [data-demo] .sparkle,
    [data-demo] .dot,
    [data-demo] .spin,
    [data-demo] .ring-pulse,
    [data-demo] [data-typing] .caret { animation: none; }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>("[data-demo]");
  if (root) {
    const scenes = [...root.querySelectorAll<HTMLElement>("[data-scenario]")];
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)").matches;
    const HOLD_MS = 3500;
    const CHAR_MS = 38;
    let current = 0;
    let timers: number[] = [];
    let clock: number | undefined;

    const later = (ms: number, fn: () => void) => timers.push(window.setTimeout(fn, ms));

    function stop() {
      timers.forEach(clearTimeout);
      timers = [];
      clearInterval(clock);
    }

    function typeOut(el: HTMLElement) {
      const text = el.dataset.text ?? "";
      const box = el.parentElement!;
      box.setAttribute("data-typing", "");
      for (let i = 1; i <= text.length; i++) later(i * CHAR_MS, () => (el.textContent = text.slice(0, i)));
      later(text.length * CHAR_MS + 250, () => box.removeAttribute("data-typing"));
    }

    function setStep(scene: HTMLElement, step: number) {
      scene.querySelectorAll<HTMLElement>("[data-at]").forEach((el) => {
        const from = Number(el.dataset.at);
        const until = el.dataset.until ? Number(el.dataset.until) : Infinity;
        el.classList.toggle("on", step >= from && step < until);
      });
      scene.querySelectorAll<HTMLElement>("[data-type]").forEach((el) => {
        const at = Number(el.dataset.typeAt);
        if (step < at) {
          el.textContent = "";
          el.parentElement!.removeAttribute("data-typing");
        } else if (reduceMotion) el.textContent = el.dataset.text ?? "";
        else if (step === at) typeOut(el);
      });
      const timer = scene.querySelector<HTMLElement>("[data-timer]");
      if (timer) {
        const at = Number(timer.dataset.timerAt);
        if (reduceMotion) timer.textContent = "00:12";
        else if (step < at) timer.textContent = "00:00";
        else if (step === at) {
          let s = 0;
          clearInterval(clock);
          clock = window.setInterval(() => (timer.textContent = `00:${String(++s).padStart(2, "0")}`), 1000);
        }
      }
    }

    function play(index: number) {
      stop();
      current = index;
      const scene = scenes[index];
      scenes.forEach((el, i) => (el.hidden = i !== index));
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.querySelector("[data-progress]")?.classList.remove("run");
      });

      if (reduceMotion) {
        setStep(scene, 99);
        return;
      }

      setStep(scene, 0);
      const plan: number[] = JSON.parse(scene.dataset.plan ?? "[]");
      let t = 0;
      plan.forEach((delay, i) => {
        t += delay;
        later(t, () => setStep(scene, i + 1));
      });

      const total = t + HOLD_MS;
      const bar = tabs[index].querySelector<HTMLElement>("[data-progress]");
      if (bar) {
        bar.style.setProperty("--dur", `${total}ms`);
        void bar.offsetWidth;
        bar.classList.add("run");
      }
      later(total, () => play((index + 1) % scenes.length));
    }

    tabs.forEach((tab, i) => tab.addEventListener("click", () => play(i)));

    // Only animate while the demo is on screen; restart the current example when it comes back.
    let onScreen = false;
    new IntersectionObserver(
      ([entry]) => {
        if (entry.isIntersecting === onScreen) return;
        onScreen = entry.isIntersecting;
        if (onScreen) play(current);
        else stop();
      },
      { threshold: 0.35 },
    ).observe(root);
  }
</script>
