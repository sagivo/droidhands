---
// A stylised version of the per-agent "Apps" screen.
type App = { name: string; letter: string; color: string; state: "on" | "off" | "never" };

const apps: App[] = [
  { name: "WhatsApp", letter: "W", color: "bg-emerald-500", state: "on" },
  { name: "Calendar", letter: "C", color: "bg-sky-500", state: "on" },
  { name: "Messages", letter: "M", color: "bg-blue-600", state: "on" },
  { name: "Gmail", letter: "G", color: "bg-rose-500", state: "off" },
  { name: "Photos", letter: "P", color: "bg-amber-500", state: "off" },
  { name: "Your bank", letter: "$", color: "bg-slate-600", state: "never" },
  { name: "Password manager", letter: "•", color: "bg-slate-600", state: "never" },
  { name: "Authenticator", letter: "2", color: "bg-slate-600", state: "never" },
];
---

<div class="relative mx-auto w-full max-w-md">
  <div class="glow-drift absolute -inset-6 -z-10 rounded-[2.5rem] bg-brand-600/20 blur-3xl"></div>
  <div class="overflow-hidden rounded-3xl bg-ink-850 shadow-2xl shadow-black/50 ring-1 ring-white/10">
    <div class="flex items-center justify-between border-b border-white/[0.06] px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-full bg-agent-500 text-sm font-bold text-white">C</span>
        <div>
          <p class="text-sm font-semibold text-white">Claude</p>
          <p class="font-mono text-xs text-slate-400">assistant · active 8:00–22:00</p>
        </div>
      </div>
      <span class="cursor-pointer rounded-full bg-rose-500/10 px-3 py-1 text-xs font-semibold text-rose-300 ring-1 ring-rose-400/25 transition-colors duration-300 hover:bg-rose-500/20">Revoke</span>
    </div>

    <p class="eyebrow px-5 pt-4 pb-2 text-slate-500">Apps this agent can use</p>
    <ul class="px-2 pb-3">
      {
        apps.map((app) => (
          <li class="group flex items-center gap-3 rounded-xl px-3 py-2.5 transition-colors duration-300 hover:bg-white/[0.04]">
            <span
              class:list={[
                "grid size-8 place-items-center rounded-lg text-sm font-bold text-white transition-all duration-300 ease-spring group-hover:scale-110",
                app.color,
                app.state === "never" && "opacity-40 grayscale",
              ]}
            >
              {app.letter}
            </span>
            <span class={`flex-1 text-sm font-medium ${app.state === "never" ? "text-slate-500" : "text-slate-200"}`}>{app.name}</span>
            {app.state === "never" ? (
              <span class="flex items-center gap-1 rounded-full bg-white/[0.05] px-2.5 py-1 font-mono text-[10px] font-semibold tracking-wide text-slate-400 ring-1 ring-white/[0.08]">
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                never allowed
              </span>
            ) : (
              <span class={`relative h-6 w-10 rounded-full transition-colors duration-300 ${app.state === "on" ? "bg-brand-500 shadow-[0_0_12px_-2px_rgb(111_102_247/0.7)]" : "bg-white/[0.12]"}`}>
                <span
                  class="absolute top-0.5 size-5 rounded-full bg-white shadow transition-all duration-300 ease-spring"
                  style={app.state === "on" ? "left: 18px" : "left: 2px"}
                />
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>
