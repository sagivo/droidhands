---
// A stylised version of the per-agent "Apps" screen.
type App = { name: string; letter: string; color: string; state: "on" | "off" | "never" };

const apps: App[] = [
  { name: "WhatsApp", letter: "W", color: "bg-emerald-500", state: "on" },
  { name: "Calendar", letter: "C", color: "bg-sky-500", state: "on" },
  { name: "Messages", letter: "M", color: "bg-blue-600", state: "on" },
  { name: "Gmail", letter: "G", color: "bg-rose-500", state: "off" },
  { name: "Photos", letter: "P", color: "bg-amber-500", state: "off" },
  { name: "Your bank", letter: "$", color: "bg-slate-700", state: "never" },
  { name: "Password manager", letter: "•", color: "bg-slate-700", state: "never" },
  { name: "Authenticator", letter: "2", color: "bg-slate-700", state: "never" },
];
---

<div class="relative mx-auto w-full max-w-md">
  <div class="absolute -inset-6 -z-10 rounded-[2.5rem] bg-gradient-to-br from-brand-100 via-white to-emerald-50 blur-2xl"></div>
  <div class="overflow-hidden rounded-3xl bg-white shadow-xl ring-1 shadow-slate-900/5 ring-slate-900/5">
    <div class="flex items-center justify-between border-b border-slate-100 px-5 py-4">
      <div class="flex items-center gap-3">
        <span class="grid size-9 place-items-center rounded-full bg-[#d97757] text-sm font-bold text-white">C</span>
        <div>
          <p class="text-sm font-semibold">Claude</p>
          <p class="text-xs text-slate-500">Assistant · active 8:00–22:00</p>
        </div>
      </div>
      <span class="rounded-full bg-rose-50 px-3 py-1 text-xs font-semibold text-rose-600">Revoke</span>
    </div>

    <p class="px-5 pt-4 pb-2 text-xs font-semibold uppercase tracking-wide text-slate-400">Apps this agent can use</p>
    <ul class="px-2 pb-3">
      {
        apps.map((app) => (
          <li class="flex items-center gap-3 rounded-xl px-3 py-2.5">
            <span class={`grid size-8 place-items-center rounded-lg text-sm font-bold text-white ${app.color}`}>{app.letter}</span>
            <span class={`flex-1 text-sm font-medium ${app.state === "never" ? "text-slate-400" : "text-slate-800"}`}>{app.name}</span>
            {app.state === "never" ? (
              <span class="flex items-center gap-1 rounded-full bg-slate-100 px-2.5 py-1 text-[11px] font-semibold text-slate-500">
                <svg viewBox="0 0 24 24" class="size-3" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round">
                  <rect width="18" height="11" x="3" y="11" rx="2" />
                  <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                </svg>
                Never allowed
              </span>
            ) : (
              <span class={`relative h-6 w-10 rounded-full transition ${app.state === "on" ? "bg-brand-600" : "bg-slate-200"}`}>
                <span class={`absolute top-0.5 size-5 rounded-full bg-white shadow ${app.state === "on" ? "left-[18px]" : "left-0.5"}`} />
              </span>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</div>
