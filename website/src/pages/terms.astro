  { id: "ai-risks", label: "AI agent risks & your responsibility" },
  { id: "third-parties", label: "Third-party apps, agents & plugins" },
  { id: "acceptable-use", label: "Acceptable use & prohibited conduct" },
  { id: "relay", label: "Default relay (no SLA)" },
  { id: "ip", label: "Open-source license & IP" },
